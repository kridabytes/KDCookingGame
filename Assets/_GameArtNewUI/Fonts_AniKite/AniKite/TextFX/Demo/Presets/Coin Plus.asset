  m_Script: {fileID: 11500000, guid: 423d95667cc6c3241b3a65d726948bb5, type: 3}
  m_Name: Coin Plus
  m_EditorClassIdentifier: 
  json: "{\n  \"schema\": \"aktextfx/1\",\n  \"id\": \"coin_plus\",\n  \"name\":
    \"Coin Plus\",\n  \"tags\": [\n    \"game\",\n    \"reward\"\n  ],\n  \"seed\":
    7,\n  \"enter\": {\n    \"unit\": \"line\",\n    \"dur\": 0.45,\n    \"spread\":
    0,\n    \"tracks\": [\n      {\n        \"prop\": \"y\",\n        \"expr\": \"(1
    - outBack(q, 2)) * 0.8\"\n      },\n      {\n        \"prop\": \"scale\",\n       
    \"expr\": \"lerp(0.6, 1, outBack(q, 2))\"\n      },\n      {\n        \"prop\":
    \"alpha\",\n        \"expr\": \"clamp(q * 4)\"\n      }\n    ]\n  },\n  \"hold\":
    {\n    \"unit\": \"line\",\n    \"ramp\": 0.3,\n    \"tracks\": [\n      {\n       
    \"prop\": \"y\",\n        \"expr\": \"sin(t * 5) * 0.05\"\n      }\n    ]\n 
    },\n  \"exit\": {\n    \"unit\": \"line\",\n    \"dur\": 0.5,\n    \"spread\":
    0,\n    \"tracks\": [\n      {\n        \"prop\": \"y\",\n        \"expr\": \"-outCubic(q)\"\n     
    },\n      {\n        \"prop\": \"alpha\",\n        \"expr\": \"1 - inQuad(q)\"\n     
    }\n    ]\n  },\n  \"material\": {\n    \"face\": {\n      \"color\": \"#FFE066\"\n   
    },\n    \"outline\": {\n      \"w\": 0.25,\n      \"color\": \"#6B3E00\"\n   
    },\n    \"shadow\": {\n      \"x\": 0.3,\n      \"y\": -0.5,\n      \"soft\":
    0.1,\n      \"color\": \"#00000099\"\n    }\n  },\n  \"font\": \"sigmar\",\n 
    \"particles\": [\n    {\n      \"preset\": \"coin\",\n      \"on\": \"land\",\n     
    \"at\": \"center\",\n      \"count\": 7,\n      \"delay\": 0.05\n    },\n   
    {\n      \"preset\": \"spark\",\n      \"on\": \"hold\",\n      \"at\": \"text\",\n     
    \"count\": 1,\n      \"every\": 0.4\n    }\n  ]\n}\n"
