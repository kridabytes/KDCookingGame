  m_Script: {fileID: 11500000, guid: 423d95667cc6c3241b3a65d726948bb5, type: 3}
  m_Name: Neon Sign
  m_EditorClassIdentifier: 
  json: "{\n  \"schema\": \"aktextfx/1\",\n  \"id\": \"neon_sign\",\n  \"name\":
    \"Neon Sign\",\n  \"tags\": [\n    \"glitch\",\n    \"emotional\"\n  ],\n  \"seed\":
    7,\n  \"enter\": {\n    \"unit\": \"char\",\n    \"order\": \"random\",\n   
    \"dur\": 0.9,\n    \"spread\": 0.6,\n    \"fps\": 20,\n    \"let\": {\n     
    \"st\": \"floor(t * 20)\"\n    },\n    \"tracks\": [\n      {\n        \"prop\":
    \"alpha\",\n        \"expr\": \"q >= 1 ? 1 : step(0.45, r(1, st)) * (0.25 + 0.75
    * q)\"\n      }\n    ]\n  },\n  \"hold\": {\n    \"unit\": \"char\",\n    \"fps\":
    15,\n    \"ramp\": 0,\n    \"tracks\": [\n      {\n        \"prop\": \"alpha\",\n       
    \"expr\": \"1 - 0.05 * step(0.92, ru(3, floor(t * 15)))\"\n      }\n    ]\n 
    },\n  \"exit\": {\n    \"unit\": \"char\",\n    \"order\": \"random\",\n    \"dur\":
    0.5,\n    \"spread\": 0.5,\n    \"fps\": 20,\n    \"tracks\": [\n      {\n       
    \"prop\": \"alpha\",\n        \"expr\": \"q <= 0 ? 1 : step(0.5, r(2, floor(t
    * 20))) * (1 - q)\"\n      }\n    ]\n  },\n  \"material\": {\n    \"face\": {\n     
    \"color\": \"#E8FFFF\"\n    },\n    \"outline\": {\n      \"w\": 0.1,\n     
    \"color\": \"#0090A0\"\n    },\n    \"glow\": {\n      \"power\": 0.6,\n     
    \"outer\": 0.5,\n      \"color\": \"#00E5FFCC\"\n    }\n  },\n  \"font\": \"tilt_neon\",\n 
    \"particles\": [\n    {\n      \"preset\": \"spark\",\n      \"on\": \"unitLand\",\n     
    \"at\": \"glyphs\",\n      \"count\": 3,\n      \"color\": [\n        \"#B8FFFF\",\n       
    \"#00E5FF\"\n      ],\n      \"size\": 0.8\n    },\n    {\n      \"preset\":
    \"lightning\",\n      \"on\": \"hold\",\n      \"at\": \"text\",\n      \"count\":
    1,\n      \"every\": 0.9,\n      \"size\": 0.7,\n      \"color\": [\n       
    \"#00E5FF\",\n        \"#B8FFFF\"\n      ],\n      \"back\": true\n    }\n  ]\n}\n"
